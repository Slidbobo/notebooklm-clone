{
  "name": "notebooklm-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/check-env.ts && npm run db:migrate && next build --turbopack && tsx scripts/check-bundle.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "secrets:local": "tsx scripts/generate-local-secrets.ts",
    "seed": "tsx scripts/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "verify:deploy": "tsx scripts/verify-deployment.ts",
    "eval": "tsx scripts/eval.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "walkthrough": "tsx scripts/walkthrough.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.58",
    "@ai-sdk/react": "^4.0.88",
    "@auth/drizzle-adapter": "^1.11.3",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.85",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "next": "15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "esbuild": "^0.25.12"
  }
}
