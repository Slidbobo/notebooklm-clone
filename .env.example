# Environment variables this project reads. Names only, no values.
#
# Local: copy to .env.local. The database URLs point at the container from
# docker-compose.yml; the rest you fill in by hand or generate.
# Vercel: set under Settings > Environment Variables, unless the column below
# says an integration sets it for you.
#
# Never commit .env.local. Never paste real values into chat logs, commit
# messages or documentation.
#
# ---------------------------------------------------------------------------
# Name                          | Local | Vercel | Set automatically?
# ---------------------------------------------------------------------------
# DATABASE_URL                  |  yes  |  yes   | Vercel: yes, by Neon
# DATABASE_URL_UNPOOLED         |  yes  |  yes   | Vercel: yes, by Neon
# BLOB_READ_WRITE_TOKEN         |  yes  |  yes   | Vercel: yes, by Blob store
# AUTH_SECRET                   |  yes  |  yes   | no
# AUTH_GITHUB_ID                |  yes  |  yes   | no, different app per env
# AUTH_GITHUB_SECRET            |  yes  |  yes   | no, different app per env
# GOOGLE_GENERATIVE_AI_API_KEY  |  yes  |  yes   | no
# DEMO_A_PASSWORD               |  yes  |   no   | no, generated locally
# DEMO_B_PASSWORD               |  yes  |   no   | no, generated locally
# ---------------------------------------------------------------------------
#
# AUTH_URL and AUTH_TRUST_HOST are deliberately absent. Auth.js v5 infers the
# host from the request headers and enables trustHost by itself when it sees
# Vercel's own environment variables. Setting them by hand only creates a second
# place that can be wrong.

# --- Database, Neon via the Vercel Marketplace ---
# Pooled connection (PgBouncer), used by the application at runtime.
# Local value for docker-compose: postgresql://postgres:postgres@localhost:5432/notebooklm
DATABASE_URL=
# Direct connection, used by drizzle-kit for migrations. PgBouncer in
# transaction mode cannot run the DDL that migrations emit.
DATABASE_URL_UNPOOLED=

# --- Vercel Blob ---
# Locally obtained with `vercel env pull`, not created by hand.
BLOB_READ_WRITE_TOKEN=

# --- Auth.js v5 ---
# Signs the session JWT. Use a different value locally than in production.
# Generate with `npx auth secret` or `npm run secrets:local`.
AUTH_SECRET=
# Two separate GitHub OAuth apps, because the callback URL differs:
#   local:      http://localhost:3000/api/auth/callback/github
#   production: https://notebooklm-clone.vercel.app/api/auth/callback/github
# Same variable names, different values per environment.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Google AI Studio (Gemini) ---
# The name the @ai-sdk/google provider reads by default. Server side only; it is
# never exposed to the browser because all inference goes through lib/llm/.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Demo accounts ---
# Read only by scripts/seed.ts, which hashes them into the users table. Sign-in
# verifies against that hash, so the plaintext is never needed at runtime and
# these two belong in .env.local only, not in Vercel.
# Generate with `npm run secrets:local`.
DEMO_A_PASSWORD=
DEMO_B_PASSWORD=
