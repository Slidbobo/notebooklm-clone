# Copy to .env.local for local development.
# On Vercel these values come from the dashboard; pull them with `vercel env pull .env.local`.
# Never commit .env.local. Never paste real values into chat logs or documentation.

# --- Database (Neon via Vercel Marketplace) ---
# Pooled connection used by the application at runtime.
DATABASE_URL=
# Direct (unpooled) connection used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# --- Auth.js v5 ---
# Generate with: npx auth secret
AUTH_SECRET=
# Separate OAuth apps for localhost and production, see README.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Google AI Studio (Gemini) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Demo accounts (seed script) ---
DEMO_A_PASSWORD=
DEMO_B_PASSWORD=
